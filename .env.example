# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=signagecms
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d
PLAYER_JWT_SECRET=player_device_secret_key_min_32_chars
PLAYER_JWT_EXPIRES_IN=365d

# Server
PORT=3000
NODE_ENV=development

# File Storage (local or S3)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=200

# AWS S3 (if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=signagecms-content

# Email (SMTP / SendGrid)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM=noreply@signagecms.in
EMAIL_FROM_NAME=SignageCMS

# Admin
ADMIN_EMAIL=admin@signagecms.in
ADMIN_PASSWORD=ChangeThisImmediately123!

# Company / Invoice details (printed on PDF invoices)
COMPANY_NAME=KARV ADTECH LLP
COMPANY_GST=27XXXXXXXXXXXXXX
COMPANY_PAN=AAACK0000X
COMPANY_ADDRESS=Your Registered Address, City, State - PIN
COMPANY_EMAIL=ads@extrravenue.com
COMPANY_PHONE=+91 XXXXXXXXXX

# GST
GST_RATE=18
PLATFORM_GST_NUMBER=27AAFCP9876Q1ZK

# WhatsApp (Aisensy / Interakt / generic)
WHATSAPP_PROVIDER=aisensy
WHATSAPP_API_KEY=
WHATSAPP_TEMPLATE=weekly_pop_report
# Per-event Aisensy template names (must match names you created in Aisensy)
WA_TPL_INVOICE=invoice_confirmed
WA_TPL_APPROVED=campaign_approved
WA_TPL_EXPIRY=expiry_reminder
WA_TPL_COMPLETED=campaign_completed
WA_TPL_POP=daily_pop_summary

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
